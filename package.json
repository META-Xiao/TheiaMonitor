{
  "name": "theia-monitor",
  "version": "0.1.0",
  "description": "Theia Monitor - Real-time MCU telemetry visualization with hex analysis",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "web": "vite",
    "dev": "node scripts/electron-dev.mjs",
    "build": "vite build --mode desktop && electron-builder --win --x64",
    "test": "npm run test:desktop && vitest run",
    "test:desktop": "node --test electron/tcp.node-test.cjs",
    "cap:sync": "vite build && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@iconify/vue": "^5.0.1",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^4.0.0",
    "@vue/compiler-sfc": "^3.3.0",
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^4.0.0",
    "vitest": "^0.34.0",
    "ws": "^8.22.2"
  }
}
